MongoDb__ConnectionString=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MongoDb__DatabaseName=SmartSolarMicrogridDb

# Optional SMTP for forgot-password, email verification, and admin broadcast emails.
# Leave SmtpPassword empty to use the Development console/fallback path instead of sending.
EmailSettings__SmtpHost=smtp.gmail.com
EmailSettings__SmtpPort=587
EmailSettings__SmtpUsername=your-email@gmail.com
EmailSettings__SmtpPassword=
EmailSettings__SenderEmail=your-email@gmail.com
EmailSettings__SenderName=SolarGrid Microgrid System
EmailSettings__AppBaseUrl=http://localhost:5173
EmailSettings__EnableSsl=true
