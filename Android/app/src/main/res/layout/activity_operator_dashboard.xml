<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="32dp" android:gravity="center">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Operator Dashboard" android:textSize="24sp" android:layout_marginBottom="32dp"/>
    <Button android:id="@+id/btnScanQr" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Scan Prosumer QR" android:layout_marginBottom="16dp"/>
    <Button android:id="@+id/btnLogout" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Logout"/>
</LinearLayout>
